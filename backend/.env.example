# ==========================================
# StudyNex Backend Environment Configuration
# ==========================================

# Port the backend server listens on
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/studynex

# Google AI Studio Gemini API Key
# Create a new key at: https://aistudio.google.com/
# NEVER commit your actual key to Git!
GEMINI_API_KEY=

# Primary Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Fallback Gemini Model if primary is unavailable or rate-limited
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Frontend URL for CORS allowance
FRONTEND_URL=http://localhost:5173
